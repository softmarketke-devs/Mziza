# Anthropic API key used by lib/claude.ts.
# When absent, the processor serves every translation from the offline bank
# instead of failing. Rural low-connectivity use is the default, not the edge case.
CLAUDE_API_KEY=

# Optional model override. See the build report note on model currency.
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Optional request timeout in milliseconds before falling back offline.
CLAUDE_TIMEOUT_MS=12000
